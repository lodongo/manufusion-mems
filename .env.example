# Create an isolated Firebase development project first. Do NOT use mems2026.
MEMS_FIREBASE_PROJECT_ID=YOUR_DEV_PROJECT_ID
MEMS_STORAGE_BUCKET=YOUR_DEV_STORAGE_BUCKET
MEMS_PUBLIC_URL=http://localhost:8080/
MEMS_SECRET_NAMES=INTASEND_SECRET_KEY,INTASEND_PUBLISHABLE_KEY
PORT=8080

# Vite environment values are public, never enter service-account/private keys here.
VITE_FIREBASE_API_KEY=YOUR_PUBLIC_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_DEV_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_DEV_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_DEV_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_WEB_APP_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_PUBLIC_FIREBASE_WEB_APP_ID
# Dev proxy uses same-origin API. Empty means same-origin in browser.
VITE_API_BASE_URL=
